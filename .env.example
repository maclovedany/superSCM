# Supabase project settings
# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy name. Use only if your project has not exposed a publishable key yet.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Agent (STEP 16). 비워 두면 /agent 만 안내를 보이고 나머지 화면은 그대로 동작합니다.
# ★ 서버에서만 읽습니다. NEXT_PUBLIC_ 접두어를 붙이면 브라우저로 새어 나갑니다.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
