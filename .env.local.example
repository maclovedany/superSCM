# 4회차 준비 커밋용 Supabase 환경변수
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 구 프로젝트에서 anon key를 사용하는 경우에만 사용합니다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ★ 서버 전용 secret 키 (STEP 19 · External API 의 GET 라우트).
#
#   sql/28-anon-lockdown.sql 이 anon 에게서 core · analytics 읽기를 전부 거뒀습니다.
#   /api/v1 의 GET 라우트에는 로그인 세션이 없으므로, 이 키로 조회합니다
#   (lib/supabase/service.ts). 비워 두면 GET 라우트가 503 "서버 자격증명 미설정" 을
#   돌려주고, 나머지 화면과 POST(Inbound)는 평소대로 동작합니다.
#
#   ★★ 절대 NEXT_PUBLIC_ 접두어를 붙이지 마세요. 붙이는 순간 Next.js 가 이 값을
#      브라우저 번들에 그대로 넣고, 방문자 누구나 RLS 를 우회할 수 있게 됩니다.
#   ★★ Vercel 에는 프로젝트 Settings → Environment Variables 에 같은 이름으로
#      등록해야 합니다. .env.local 은 커밋하지도 배포되지도 않습니다.
#
#   Supabase 대시보드 → Project Settings → API Keys → secret key (sb_secret_…)
SUPABASE_SECRET_KEY=

# Python 예측 서비스 (STEP 8). 비워두면 SQL 모델만 실행되고 화면은 그대로 돕니다.
# 서비스의 SERVICE_TOKEN 과 FORECAST_SERVICE_TOKEN 은 같은 값이어야 합니다.
FORECAST_SERVICE_URL=
FORECAST_SERVICE_TOKEN=

# 알림 스캔 스케줄러 (STEP 14). vercel.json 의 crons 가 /api/cron/scan-alerts 를 부를 때
# Authorization: Bearer ${CRON_SECRET} 로 인증합니다. 비워 두면 그 경로는 아무도 통과하지 못합니다.
# 같은 값을 DB 에도 한 번 심습니다 (sql/20-alert.sql 파일 머리 주석).
#   alter database postgres set app.cron_secret = '충분히-긴-무작위-문자열';
CRON_SECRET=

# AI Agent (STEP 16). 셋 중 하나라도 비면 /agent 화면이 "AI 가 설정되지 않았습니다" 를
# 보이고, 나머지 화면은 평소대로 동작합니다 (renew.prd 31.4).
# OpenAI 호환 API 를 fetch 로 직접 부릅니다. SDK 를 설치하지 않았으므로,
# 2단계에서 고객사 사내 vLLM · Ollama 로 옮길 때는 base URL 만 바꾸면 됩니다.
#   예) OPENAI_BASE_URL=http://vllm.internal:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
