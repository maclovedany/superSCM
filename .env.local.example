# 4회차 준비 커밋용 Supabase 환경변수
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 구 프로젝트에서 anon key를 사용하는 경우에만 사용합니다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Agent (STEP 16). 비워 두면 /agent 만 안내를 보이고 나머지 화면은 그대로 동작합니다.
# ★ 서버에서만 읽습니다. NEXT_PUBLIC_ 접두어를 붙이면 브라우저로 새어 나갑니다.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 알림 발송 작업. 모두 서버에서만 읽으므로 NEXT_PUBLIC_ 접두어를 붙이지 않습니다.
# Supabase의 새 secret key 또는 구 프로젝트 service_role key 중 하나만 설정합니다.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key
# CRON_SECRET=충분히-긴-임의값
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=SCM 알림 <scm@example.com>
# RESEND_REPLY_TO=contact@example.com
# 발신 주소가 alert@send.example.com처럼 수신함 없는 발송 전용 하위 도메인이면,
# 받는 사람이 답장했을 때 반송되지 않도록 실제 수신 가능한 주소를 RESEND_REPLY_TO에 넣습니다.
# 비워 두면 이전과 동일하게 동작합니다(reply_to 필드 자체를 보내지 않음).
# 10분 주기는 Vercel Pro 이상 또는 동등한 외부 스케줄러가 필요합니다.
# 운영 기준: docs/notification-operations.md
