# 예측 서비스 환경변수. 복사해서 .env 로 쓰거나 Railway Variables 에 넣습니다.

# Supabase → Project Settings → Database → Connection string (URI).
# PostgREST 를 거치지 않고 직접 접속합니다. RLS 는 테이블 소유자에게 적용되지 않습니다.
# ★ postgres 사용자로 접속해야 합니다 (직접 접속 또는 Supavisor 세션 모드).
#   sql/25 의 core.is_admin() 이 session_user = 'postgres' 만 관리자로 봅니다.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Next.js 의 FORECAST_SERVICE_TOKEN 과 같은 값을 넣습니다.
# 설정하지 않으면 /health 를 뺀 모든 엔드포인트가 401 입니다.
SERVICE_TOKEN=change-me

# 선택
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=5
# /health 의 DB 확인 결과를 몇 초 재사용할지. 관리자 화면이 렌더마다 부릅니다.
DB_PING_TTL=45
