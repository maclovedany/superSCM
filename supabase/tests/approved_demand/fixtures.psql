-- 확정 수요 구성 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists approved_test;
grant usage on schema approved_test to anon, authenticated;

create or replace function approved_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function approved_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function approved_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

grant execute on all functions in schema approved_test to anon, authenticated;

