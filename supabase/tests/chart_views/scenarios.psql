-- 차트 데이터 뷰 검증 시나리오. 로컬 임시 DB(scm_test_*) 전용, fixtures.psql 적용 뒤 실행.
-- 구조는 supabase/tests/inventory_kpi와 같다: 사용자 컨텍스트가 필요한 구간은 `set role
-- authenticated` 안에서 as_user()로 auth.uid()를 지정한다.
\set ON_ERROR_STOP 1
\ir guard.psql
\pset tuples_only on
\pset format unaligned

\set planner1 '00000000-0000-4000-8000-000000000901'
\set marketing1 '00000000-0000-4000-8000-000000000902'


-- fix round 1(팀장 판정, 리뷰 §3-b/B-5) — 세 뷰 전부 권한 게이트를 뺐다(기존
-- v_shipment_trend·v_forecast_result·v_champion_model과 같은 자세). S1·S1b는 이제 "권한 없는
-- 사용자도 막히지 않는다"를 확인한다 — 예전처럼 0행이면 오히려 회귀다.
\echo '== S1 무게이트(v_demand_series) — STOCK_VIEW_ALL 없는 마케팅도 막히지 않는다 =='
set role authenticated;
select chart_test.as_user(:'marketing1') \g /dev/null
select count(*) as s1_count from analytics.v_demand_series \gset
reset role;
select chart_test.check(:'s1_count' > '0', 'S1 마케팅도 v_demand_series를 본다(권한 게이트 없음, 기존 v_forecast_result와 같은 자세)');


\echo '== S1b 무게이트(출고 뷰) — 같은 마케팅 사용자도 출고 뷰를 막힘 없이 본다 =='
set role authenticated;
select chart_test.as_user(:'marketing1') \g /dev/null
select count(*) as s1b_rollup from analytics.v_shipment_monthly_rollup \gset
select count(*) as s1b_item from analytics.v_shipment_monthly_item where item_code = 'CHSHIP01' \gset
reset role;
select chart_test.check(:'s1b_rollup' > '0', 'S1b 마케팅도 v_shipment_monthly_rollup을 본다(기존 v_shipment_trend와 같은 자세)');
select chart_test.check(:'s1b_item' = '8', 'S1b 마케팅도 v_shipment_monthly_item에서 CHSHIP01 8개월을 그대로 본다');


-- error.md #26 — null일 수 있는 열은 \gset으로 담지 않는다(null이면 변수가 설정되지 않아 뒤에서
-- ':'변수'가 리터럴로 남아 구문 오류가 난다). 조건 전체를 서브쿼리 안에서 판정한다(S3~S6과 동일).
\echo '== S2 실적과 예측(밴드 포함)이 같은 달에 다 있으면 사유 코드 전부 null이고 champion(MA_3M)만 나온다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select actual_qty = 80 and actual_reason_code is null
     from analytics.v_demand_series where item_id = 'CHDEM01' and period = '2026-07-01') as s2_actual_ok \gset
select
  (select model_id = 'MA_3M' and predicted_qty = 100 and predicted_reason_code is null
     from analytics.v_demand_series where item_id = 'CHDEM01' and period = '2026-07-01') as s2_predicted_ok \gset
select
  (select p80 = 110 and p90 = 120 and band_reason_code is null
     from analytics.v_demand_series where item_id = 'CHDEM01' and period = '2026-07-01') as s2_band_ok \gset
reset role;
select chart_test.check(:'s2_actual_ok', 'S2 출처 없는(batch_id null) 행은 합계에서 빠진다(80, 999 아님) + 사유코드 null');
select chart_test.check(:'s2_predicted_ok', 'S2 champion 모델(MA_3M, 100)만 나온다 — decoy(MA_6M, 999) 아님, 사유코드 null');
select chart_test.check(:'s2_band_ok', 'S2 밴드도 champion 모델 값(110·120) + 사유코드 null');


\echo '== S3 실적만 있고 Backtest·Champion 선정 자체가 없으면 NO_CHAMPION_SELECTION =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select count(*) as s3_rows from analytics.v_demand_series where item_id = 'CHDEM02' \gset
select
  (select predicted_qty is null and predicted_reason_code = 'NO_CHAMPION_SELECTION'
     from analytics.v_demand_series where item_id = 'CHDEM02' and period = '2026-07-01') as s3_ok \gset
reset role;
select chart_test.check(:'s3_rows' = '1', 'S3 CHDEM02는 실적 달 1행뿐(예측 기간이 없으니 합집합도 1행)');
select chart_test.check(:'s3_ok', 'S3 predicted_qty null + NO_CHAMPION_SELECTION');


\echo '== S4 기간 갭 — 실적(2026-06)과 예측(2026-08)이 다른 달이면 두 행 다 남고 서로의 반대쪽이 비어 갭이 보인다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select count(*) as s4_rows from analytics.v_demand_series where item_id = 'CHDEM03' \gset
select
  (select predicted_qty is null and predicted_reason_code = 'PERIOD_NOT_FORECASTED'
     from analytics.v_demand_series where item_id = 'CHDEM03' and period = '2026-06-01') as s4_jun_ok \gset
select
  (select actual_qty is null and actual_reason_code = 'NO_ACTUAL_USAGE' and predicted_qty = 50
     from analytics.v_demand_series where item_id = 'CHDEM03' and period = '2026-08-01') as s4_aug_ok \gset
reset role;
select chart_test.check(:'s4_rows' = '2', 'S4 실적 달 · 예측 달 두 행이 합쳐지지 않고 둘 다 남는다(갭)');
select chart_test.check(:'s4_jun_ok', 'S4 2026-06은 실적만 있고 예측은 PERIOD_NOT_FORECASTED(champion은 있다)');
select chart_test.check(:'s4_aug_ok', 'S4 2026-08은 예측만 있고 실적은 NO_ACTUAL_USAGE');


\echo '== S5 Backtest는 됐지만 유효 후보가 없으면(NO_VALID_CANDIDATE) NO_CHAMPION_MODEL이다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select predicted_qty is null and predicted_reason_code = 'NO_CHAMPION_MODEL'
     and band_reason_code = 'NO_CHAMPION_MODEL'
     from analytics.v_demand_series where item_id = 'CHDEM04' and period = '2026-07-01') as s5_ok \gset
reset role;
select chart_test.check(:'s5_ok', 'S5 predicted_qty null + NO_CHAMPION_MODEL(밴드도 같은 사유를 물려받는다)');


\echo '== S6 예측은 있는데 p80·p90이 없으면 BAND_UNAVAILABLE이다 — 절대 다른 값으로 채우지 않는다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select predicted_qty = 70 and predicted_reason_code is null
     and p80 is null and p90 is null and band_reason_code = 'BAND_UNAVAILABLE'
     from analytics.v_demand_series where item_id = 'CHDEM05' and period = '2026-07-01') as s6_ok \gset
reset role;
select chart_test.check(:'s6_ok', 'S6 predicted_qty는 있고 밴드만 BAND_UNAVAILABLE — predicted_reason_code는 null(예측 자체는 문제 없다)');


-- fix round 1 — CHSHIP03(SUPPLY, 2026-01~07) · CHSHIP04(GAP_TYPE, 2020-01~03 + 2026-12)를
-- fixture에 더해(B-1·B-3 시나리오용) TOTAL·ITEM_TYPE 행 수와 2026-07 합계가 늘었다.
\echo '== S7 출고 월별 롤업 — TOTAL·ITEM_TYPE 행 수와 합계가 맞는다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select count(*) as s7_total_rows from analytics.v_shipment_monthly_rollup where level = 'TOTAL' \gset
select count(*) as s7_type_rows from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' \gset
-- qty는 numeric(18,4)라 텍스트로 \gset해 비교하면 '1040' vs '1040.0000'로 어긋난다 — 숫자 비교는
-- 서브쿼리 안에서 끝낸다.
select
  (select qty = 1090 from analytics.v_shipment_monthly_rollup where level = 'TOTAL' and ym = '2026-07') as s7_total_jul_ok \gset
select
  (select qty = 1000 from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'PART' and ym = '2026-07') as s7_part_jul_ok \gset
reset role;
select chart_test.check(:'s7_total_rows' = '12', 'S7 TOTAL 레벨 = {2020-01,02,03} + {2026-01..08} + {2026-12} = 12개월');
select chart_test.check(:'s7_type_rows' = '22', 'S7 ITEM_TYPE 레벨 = PART 8 + OPTION 3 + SUPPLY 7 + GAP_TYPE 4 = 22행');
select chart_test.check(:'s7_total_jul_ok', 'S7 2026-07 TOTAL = PART 1000 + OPTION 40 + SUPPLY 50');
select chart_test.check(:'s7_part_jul_ok', 'S7 2026-07 PART = 1000(스파이크)');


\echo '== S8 출고 이상치 신호 — trailing 6개월 관측치가 3개월 미만이면 null, 스파이크 달은 배수가 크게 뜬다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select qty_vs_trailing_6m_avg is null and trend_reason_code = 'INSUFFICIENT_TRAILING_HISTORY'
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'PART' and ym = '2026-01') as s8_early_ok \gset
select
  (select qty_vs_trailing_6m_avg is null and trend_reason_code = 'INSUFFICIENT_TRAILING_HISTORY'
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'PART' and ym = '2026-02') as s8_early2_ok \gset
select
  (select qty_vs_trailing_6m_avg > 5 and trend_reason_code is null
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'PART' and ym = '2026-07') as s8_spike_ok \gset
reset role;
select chart_test.check(:'s8_early_ok', 'S8 2026-01(관측치 0개)은 배수 null + INSUFFICIENT_TRAILING_HISTORY');
select chart_test.check(:'s8_early2_ok', 'S8 2026-02(관측치 1개)도 아직 null + INSUFFICIENT_TRAILING_HISTORY');
select chart_test.check(:'s8_spike_ok', 'S8 스파이크 달(2026-07)은 계산된 배수(>5배) + 사유코드 null — 달을 하드코딩하지 않았다');


\echo '== S9 출고 품목×월 — HOC 대표코드 기준으로 특정 품목만 필터해 읽는다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select count(*) as s9_rows from analytics.v_shipment_monthly_item where item_code = 'CHSHIP01' \gset
select
  (select qty = 1000 from analytics.v_shipment_monthly_item where item_code = 'CHSHIP01' and ym = '2026-07') as s9_jul_ok \gset
reset role;
select chart_test.check(:'s9_rows' = '8', 'S9 CHSHIP01은 8개월(2026-01~08) 전부 나온다');
select chart_test.check(:'s9_jul_ok', 'S9 2026-07 수량은 스파이크 값 1000 그대로(스무딩하지 않는다)');


-- fix round 1(리뷰 B-4) — CHDEM05(p80·p90 둘 다 null)만으로는 `p90 := coalesce(p90, p80)` 같은
-- 날조가 검증을 통과한다(리뷰 M5, 22/22로 안 잡힘). 부분 밴드(p80만 있음) 픽스처로 그 틈을 막는다.
\echo '== S10 부분 밴드 — p80만 있고 p90이 없어도 p90을 다른 값으로 채우지 않는다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select predicted_qty = 90 and predicted_reason_code is null
     and p80 = 95 and p90 is null and band_reason_code = 'BAND_UNAVAILABLE'
     from analytics.v_demand_series where item_id = 'CHDEM06' and period = '2026-07-01') as s10_ok \gset
reset role;
select chart_test.check(:'s10_ok', 'S10 p80=95는 그대로, p90은 null 그대로(p80 값으로 채워지지 않는다) + BAND_UNAVAILABLE');


-- fix round 1(리뷰 B-1) — 재현 가능한 null(직전 6개월 평균이 정확히 0)에 사유 코드가 없던 것을
-- TRAILING_AVG_ZERO로 고쳤다. CHSHIP03(SUPPLY)은 2026-01~06이 전부 0이다.
\echo '== S11 직전 평균이 정확히 0이면 배수는 null이지만 사유 코드는 반드시 있다(TRAILING_AVG_ZERO) =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select qty_vs_trailing_6m_avg is null and trend_reason_code = 'TRAILING_AVG_ZERO'
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'SUPPLY' and ym = '2026-04') as s11_first3_ok \gset
select
  (select qty_vs_trailing_6m_avg is null and trend_reason_code = 'TRAILING_AVG_ZERO'
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'SUPPLY' and ym = '2026-07') as s11_spike_ok \gset
select
  (select qty = 50 from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'SUPPLY' and ym = '2026-07') as s11_qty_ok \gset
reset role;
select chart_test.check(:'s11_first3_ok', 'S11 2026-04(관측치 3개, 전부 0)는 배수 null + TRAILING_AVG_ZERO(INSUFFICIENT 아님)');
select chart_test.check(:'s11_spike_ok', 'S11 2026-07(관측치 6개, 전부 0)도 마찬가지 — 실제 값(50)이 있어도 기준선이 0이면 배수를 낼 수 없다');
select chart_test.check(:'s11_qty_ok', 'S11 qty 자체는 스무딩 없이 50 그대로');


-- fix round 1(리뷰 B-3) — "직전 6개월"이 행이 아니라 달력 기준임을 확인한다. CHSHIP04(GAP_TYPE)는
-- 2020-01~03에만 있고 다음 행이 2026-12(6년 공백)다. 고치기 전에는 `rows between 6 preceding`이
-- 이 3개 행을 "직전 6개월"로 잘못 세어(리뷰어 실측 4.00배 재현과 같은 모양) 터무니없는 배수를
-- 냈다 — RANGE(달력 구간)로 고친 뒤에는 그 3개 행이 프레임 밖이라 관측치 0개여야 한다.
\echo '== S12 달력 기준 6개월 — 6년 전 행을 직전 6개월로 잘못 세지 않는다 =='
set role authenticated;
select chart_test.as_user(:'planner1') \g /dev/null
select
  (select qty_vs_trailing_6m_avg is null and trend_reason_code = 'INSUFFICIENT_TRAILING_HISTORY'
     from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'GAP_TYPE' and ym = '2026-12') as s12_ok \gset
select
  (select qty = 999 from analytics.v_shipment_monthly_rollup where level = 'ITEM_TYPE' and item_type = 'GAP_TYPE' and ym = '2026-12') as s12_qty_ok \gset
reset role;
select chart_test.check(:'s12_ok', 'S12 2026-12은 6년 전 3개 행을 트레일링으로 세지 않는다 — 관측치 0개, INSUFFICIENT_TRAILING_HISTORY(터무니없는 배수 아님)');
select chart_test.check(:'s12_qty_ok', 'S12 qty 자체는 999 그대로');
