  ('00000000-0000-4000-8000-000000000101', 't7-planner1@example.test', 'SCM품목담당1', 'SCM', 'USER', true, 'SCM_PLANNER'),
  ('00000000-0000-4000-8000-000000000102', 't7-lead1@example.test', 'SCM팀장1', 'SCM', 'USER', true, 'SCM_LEAD'),
  ('00000000-0000-4000-8000-000000000103', 't7-marketing1@example.test', '마케팅1', 'MARKETING', 'USER', true, 'MARKETING'),
  ('00000000-0000-4000-8000-000000000104', 't7-marketing2@example.test', '마케팅2', 'MARKETING', 'USER', true, 'MARKETING'),
  ('00000000-0000-4000-8000-000000000105', 't7-service1@example.test', '서비스1', 'SERVICE', 'USER', true, 'SERVICE'),
  ('00000000-0000-4000-8000-000000000106', 't7-admin1@example.test', '관리자1', null, 'ADMIN', true, null),
