  ('00000000-0000-4000-8000-000000000105', 't7-service1@example.test'),
  ('00000000-0000-4000-8000-000000000106', 't7-admin1@example.test'),
  ('00000000-0000-4000-8000-000000000107', 't7-nodept@example.test')
on conflict (id) do nothing;

