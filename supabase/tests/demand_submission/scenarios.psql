-- 부서별 월간 수요 제출 · 마감 관리 검증 시나리오 — 로컬 임시 DB(scm_test_*) 전용, fixtures.psql 적용 뒤 실행
\set ON_ERROR_STOP 1
\ir guard.psql
\pset tuples_only on
\pset format unaligned
\set planner1 '00000000-0000-4000-8000-000000000101'
\set lead1 '00000000-0000-4000-8000-000000000102'
\set marketing1 '00000000-0000-4000-8000-000000000103'
\set marketing2 '00000000-0000-4000-8000-000000000104'
\set service1 '00000000-0000-4000-8000-000000000105'
\set admin1 '00000000-0000-4000-8000-000000000106'
\set nodept1 '00000000-0000-4000-8000-000000000107'

-- 이번 달 취합 주기는 마감일이 항상 과거(대상월 1일 - 2일 < 오늘)라 "마감 경과" 시나리오에 쓴다.
-- 두 달 뒤 취합 주기는 항상 마감일이 미래라 정상 작성·제출·합의 흐름에 쓴다.
select to_char(date_trunc('month', current_date), 'YYYY-MM-01') as cur_month \gset
select to_char(date_trunc('month', current_date) + interval '2 months', 'YYYY-MM-01') as future_month \gset
\echo :cur_month
\echo :future_month

\echo '== S1 마감일 계산 — 28 · 29 · 30 · 31일 말일과 stage1 예시 =='
select demand_test.check(core.submission_deadline('2026-04-01') = '2026-03-30', 'S1 31일 말일(3월) → stage1 예시와 동일하게 3월 30일');
select demand_test.check(core.submission_deadline('2026-03-01') = '2026-02-27', 'S1 28일 말일(평년 2월) → 2월 27일');
select demand_test.check(core.submission_deadline('2028-03-01') = '2028-02-28', 'S1 29일 말일(윤년 2월) → 2월 28일');
select demand_test.check(core.submission_deadline('2026-05-01') = '2026-04-29', 'S1 30일 말일(4월) → 4월 29일');
select demand_test.check(core.submission_deadline('2026-01-01') = '2025-12-30', 'S1 연도 경계(1월 대상월)도 전년 12월 기준');

\echo '== S2 취합 주기 열기 — 권한 · 중복 월 거절 =='
set role authenticated;
select demand_test.as_user(:'marketing1') \g /dev/null
select demand_test.expect_error(format('select core.open_planning_cycle(%L::date)', :'cur_month'), 'SCM 품목담당자 또는 관리자만', 'S2 DEMAND_SUBMIT만 있는 사용자는 취합 주기를 열 수 없다');
select demand_test.as_user(:'planner1') \g /dev/null
select core.open_planning_cycle(:'cur_month'::date) as cur_cycle \gset
select demand_test.check(:'cur_cycle' is not null, 'S2 SCM 품목담당자가 이번 달 취합 주기를 연다');
select demand_test.expect_error(format('select core.open_planning_cycle(%L::date)', :'cur_month'), '이미 해당 월의 취합 주기가 열려 있습니다', 'S2 같은 달을 다시 열면 거절');
select demand_test.as_user(:'admin1') \g /dev/null
select core.open_planning_cycle(:'future_month'::date) as future_cycle \gset
select demand_test.check(:'future_cycle' is not null, 'S2 ADMIN도 취합 주기를 열 수 있다');
reset role;
select demand_test.check((select submission_deadline from core.planning_cycle where cycle_id = :'future_cycle') = core.submission_deadline(:'future_month'::date),
  'S2 저장된 마감일이 core.submission_deadline과 같다');

\echo '== S3 제출 시작 — 권한 · 열린 주기 필요 · 부서 필요 · 멱등 =='
set role authenticated;
select demand_test.as_user(:'lead1') \g /dev/null
select demand_test.expect_error('select core.start_demand_submission(current_date::date)', '부서 수요 제출 권한이 없습니다', 'S3 DEMAND_SUBMIT이 없는 SCM팀장은 작성을 시작할 수 없다');
select demand_test.as_user(:'nodept1') \g /dev/null
select demand_test.expect_error(format('select core.start_demand_submission(%L::date)', :'future_month'), '소속 부서가 설정되지 않았습니다', 'S3 부서 미설정 계정은 거절');
select demand_test.as_user(:'marketing1') \g /dev/null
select demand_test.expect_error('select core.start_demand_submission((current_date + interval ''6 months'')::date)', '해당 월의 수요 취합 주기가 열려 있지 않습니다', 'S3 열리지 않은 달은 거절');
select core.start_demand_submission(:'future_month'::date) as mkt_sub \gset
select demand_test.check(:'mkt_sub' is not null, 'S3 마케팅1이 두 달 뒤 취합 주기 작성을 시작한다');
select demand_test.as_user(:'marketing2') \g /dev/null
select core.start_demand_submission(:'future_month'::date) as mkt_sub2 \gset
select demand_test.check(:'mkt_sub2' = :'mkt_sub', 'S3 같은 부서 다른 사용자가 다시 시작하면 같은 제출본(멱등 get-or-create)');
reset role;
select demand_test.check((select status = 'DRAFT' and department = 'MARKETING' from core.demand_submission where submission_id = :'mkt_sub'), 'S3 새 제출본은 DRAFT · MARKETING');
select demand_test.check((select event_type = 'CREATED' and next_status = 'DRAFT' from core.demand_submission_event where submission_id = :'mkt_sub'), 'S3 CREATED 이벤트가 같은 트랜잭션에 남는다');

\echo '== S4 항목 저장 — 품목코드 불일치 · null 수량 · 잘못된 필요월을 행 오류로 남긴다 =='
set role authenticated;
select demand_test.as_user(:'service1') \g /dev/null
select demand_test.expect_error(format('select core.save_demand_submission_lines(%L, %L::jsonb)', :'mkt_sub', '[]'), '다른 부서의 제출본은 수정할 수 없습니다', 'S4 다른 부서는 항목을 저장할 수 없다(서버 함수 가드)');
select demand_test.as_user(:'marketing1') \g /dev/null
select core.save_demand_submission_lines(:'mkt_sub', $j$[
  {"item_id": "itemd 01", "qty": "10", "need_month": "2026-04"},
  {"item_id": "UNKNOWN999", "qty": "5", "need_month": "2026-04"},
  {"item_id": "ITEMD02", "qty": null, "need_month": "2026-04"},
  {"item_id": "ITEMD02", "qty": "-3", "need_month": "2026-04"},
  {"item_id": "ITEMD02", "qty": "5", "need_month": "2026-13"},
  {"item_id": "ITEMD02", "qty": "5", "need_month": ""}
]$j$::jsonb) \g /dev/null
reset role;
select demand_test.check((select item_id = 'ITEMD01' and jsonb_array_length(issues) = 0 from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 1),
  'S4 공백·소문자·하이픈 품목코드도 STEP 4와 같은 정규화로 매칭되고 오류가 없다');
select demand_test.check((select item_id is null and issues @> '[{"code":"UNKNOWN_ITEM"}]' from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 2),
  'S4 알 수 없는 품목코드는 지우지 않고 행 오류(UNKNOWN_ITEM)로 남긴다');
select demand_test.check((select qty is null and issues @> '[{"code":"REQUIRED_VALUE","field_name":"qty"}]' from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 3),
  'S4 null 수량은 0으로 채우지 않고 행 오류(REQUIRED_VALUE)로 남긴다');
select demand_test.check((select qty is null and issues @> '[{"code":"NEGATIVE_QUANTITY"}]' from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 4),
  'S4 음수 수량은 행 오류(NEGATIVE_QUANTITY)로 남긴다');
select demand_test.check((select need_month is null and issues @> '[{"code":"INVALID_DATE"}]' from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 5),
  'S4 존재하지 않는 달(2026-13)은 잘못된 날짜로 남긴다');
select demand_test.check((select need_month is null and issues @> '[{"code":"REQUIRED_VALUE","field_name":"need_month"}]' from core.demand_submission_line where submission_id = :'mkt_sub' and line_no = 6),
  'S4 필요월 누락은 REQUIRED_VALUE로 남긴다');
select demand_test.check((select count(*) = 6 from core.demand_submission_line where submission_id = :'mkt_sub'), 'S4 오류 행도 조용히 지우지 않고 전부 저장된다(6행)');

\echo '== S5 제출 — ERROR 행이 있으면 제출 완료로 바뀌지 않는다 =='
set role authenticated;
select demand_test.as_user(:'marketing1') \g /dev/null
select demand_test.expect_error(format('select core.submit_demand_submission(%L)', :'mkt_sub'), '오류가 있는 항목', 'S5 ERROR 행이 있으면 제출을 거절한다');
select core.save_demand_submission_lines(:'mkt_sub', $j$[{"item_id": "ITEMD01", "qty": "10", "need_month": "2026-04"}]$j$::jsonb) \g /dev/null
select demand_test.as_user(:'service1') \g /dev/null
select demand_test.expect_error(format('select core.submit_demand_submission(%L)', :'mkt_sub'), '다른 부서의 제출본은 제출할 수 없습니다', 'S5 다른 부서는 제출할 수 없다');
select demand_test.as_user(:'marketing1') \g /dev/null
select (core.submit_demand_submission(:'mkt_sub')).status as mkt_status \gset
select demand_test.check(:'mkt_status' = 'SUBMITTED', 'S5 오류 없는 제출본은 정상적으로 SUBMITTED로 바뀐다');
select demand_test.expect_error(format('select core.submit_demand_submission(%L)', :'mkt_sub'), '이미 제출되었거나 합의된 자료입니다', 'S5 이미 제출된 것을 다시 제출하면 거절');
reset role;
-- CREATED(1) → S4 저장(2, 오류 6행) → S5 재저장(3, 오류 없는 1행) → 제출(4)
select demand_test.check((select version = 4 from core.demand_submission where submission_id = :'mkt_sub'), 'S5 버전이 저장·재저장·제출을 거치며 1→4로 증가한다');
select demand_test.check((select previous_status = 'DRAFT' and next_status = 'SUBMITTED' from core.demand_submission_event where submission_id = :'mkt_sub' and event_type = 'SUBMITTED'),
  'S5 SUBMITTED 이벤트에 이전·다음 상태가 함께 남는다');

\echo '== S6 합의 확정 — SCM 품목담당자·ADMIN만, 제출완료만, 확정 후 편집 잠금 =='
set role authenticated;
select demand_test.as_user(:'marketing1') \g /dev/null
select demand_test.expect_error(format('select core.agree_demand_submission(%L)', :'mkt_sub'), 'SCM 품목담당자 또는 관리자만', 'S6 제출 부서는 스스로 합의를 확정할 수 없다');
select demand_test.as_user(:'planner1') \g /dev/null
select (core.agree_demand_submission(:'mkt_sub')).status as mkt_agreed_status \gset
select demand_test.check(:'mkt_agreed_status' = 'AGREED', 'S6 SCM 품목담당자가 합의를 확정한다');
select demand_test.expect_error(format('select core.agree_demand_submission(%L)', :'mkt_sub'), '제출완료 상태만 합의를 확정할 수 있습니다', 'S6 이미 합의된 것을 다시 확정하면 거절');
select demand_test.as_user(:'marketing1') \g /dev/null
select demand_test.expect_error(format('select core.save_demand_submission_lines(%L, %L::jsonb)', :'mkt_sub', '[]'), '회수한 뒤에만 수정할 수 있습니다', 'S6 합의완료 제출본은 부서가 더 이상 수정할 수 없다(잠금)');
reset role;

\echo '== S7 회수 — 제출완료만, 사유 필수, 마감 전 회수는 알림을 새로 예약하지 않는다 =='
set role authenticated;
select demand_test.as_user(:'service1') \g /dev/null
select core.start_demand_submission(:'future_month'::date) as svc_future_sub \gset
select demand_test.expect_error(format('select core.withdraw_demand_submission(%L, %L)', :'svc_future_sub', '사유'), '제출된 자료만 회수할 수 있습니다', 'S7 DRAFT는 회수할 수 없다');
select core.save_demand_submission_lines(:'svc_future_sub', $j$[{"item_id": "ITEMD02", "qty": "1", "need_month": "2026-04"}]$j$::jsonb) \g /dev/null
select core.submit_demand_submission(:'svc_future_sub') \g /dev/null
select demand_test.expect_error(format('select core.withdraw_demand_submission(%L, %L)', :'svc_future_sub', ''), '회수 사유는 필수입니다', 'S7 회수 사유 없이 거절');
select (core.withdraw_demand_submission(:'svc_future_sub', '내용 오류로 재작성')).status as svc_withdrawn_status \gset
select demand_test.check(:'svc_withdrawn_status' = 'WITHDRAWN', 'S7 제출완료를 회수하면 WITHDRAWN이 된다');
reset role;
select demand_test.check((select withdraw_reason = '내용 오류로 재작성' from core.demand_submission where submission_id = :'svc_future_sub'), 'S7 회수 사유가 저장된다');
select demand_test.check((select count(*) = 0 from core.notification_outbox where payload ->> 'series_id' = (:'future_cycle' || ':SERVICE') and status = 'PENDING'),
  'S7 마감 전(미래 주기) 회수는 미제출 반복 알림을 새로 예약하지 않는다');

\echo '== S8 마감 후 회수는 반복 미제출 알림을 즉시 재개한다 =='
set role authenticated;
select demand_test.as_user(:'service1') \g /dev/null
select core.start_demand_submission(:'cur_month'::date) as svc_cur_sub \gset
select core.save_demand_submission_lines(:'svc_cur_sub', $j$[{"item_id": "ITEMD02", "qty": "1", "need_month": "2026-04"}]$j$::jsonb) \g /dev/null
select core.submit_demand_submission(:'svc_cur_sub') \g /dev/null
select core.withdraw_demand_submission(:'svc_cur_sub', '마감 후 재작성') \g /dev/null
reset role;
select demand_test.check((select count(*) > 0 from core.notification_outbox
  where payload ->> 'series_id' = (:'cur_cycle' || ':SERVICE') and template_code = 'DEMAND_SUBMISSION_OVERDUE' and status = 'PENDING'),
  'S8 마감이 지난 뒤 회수하면 미제출 반복 알림이 즉시 다시 예약된다');

\echo '== S9 마감 경과 후 미제출 부서 반복 알림 예약(Cron 함수) — 중복 없이, 제출 완료 시 중단 =='
select core.raise_demand_submission_reminders() as raised_1 \gset
select demand_test.check((select count(*) = 4 from core.notification_outbox
    where payload ->> 'series_id' = (:'cur_cycle' || ':MARKETING') and template_code = 'DEMAND_SUBMISSION_OVERDUE'),
  'S9 MARKETING(마케팅1·마케팅2 · 2채널)이 이번 달에 제출하지 않아 4건이 예약된다');
select core.raise_demand_submission_reminders() as raised_2 \gset
select demand_test.check((select count(*) = 4 from core.notification_outbox
    where payload ->> 'series_id' = (:'cur_cycle' || ':MARKETING') and template_code = 'DEMAND_SUBMISSION_OVERDUE'),
  'S9 Cron을 다시 불러도 같은 고정 시각 dedupe_key라 중복 예약되지 않는다');
set role authenticated;
select demand_test.as_user(:'marketing1') \g /dev/null
select core.start_demand_submission(:'cur_month'::date) as mkt_cur_sub \gset
select core.save_demand_submission_lines(:'mkt_cur_sub', $j$[{"item_id": "ITEMD01", "qty": "1", "need_month": "2026-04"}]$j$::jsonb) \g /dev/null
select core.submit_demand_submission(:'mkt_cur_sub') \g /dev/null
reset role;
select demand_test.check((select count(*) = 0 from core.notification_outbox
    where payload ->> 'series_id' = (:'cur_cycle' || ':MARKETING') and status = 'PENDING'),
  'S9 제출 완료 시 해당 부서의 반복 미제출 알림이 즉시 중단된다(대기 중 0건)');
select core.raise_demand_submission_reminders() as raised_3 \gset
select demand_test.check((select count(*) = 4 from core.notification_outbox
    where payload ->> 'series_id' = (:'cur_cycle' || ':MARKETING') and template_code = 'DEMAND_SUBMISSION_OVERDUE'),
  'S9 제출완료 부서는 Cron을 다시 불러도 새 알림을 받지 않는다(4건 그대로)');

\echo '== S10 RLS — 다른 부서 제출본은 보이지 않고, SCM·ADMIN은 전체를 본다 =='
set role authenticated;
select demand_test.as_user(:'service1') \g /dev/null
select demand_test.check((select count(*) = 0 from core.demand_submission where submission_id = :'mkt_sub'), 'S10 다른 부서(SERVICE)는 MARKETING 제출본을 볼 수 없다');
select demand_test.as_user(:'planner1') \g /dev/null
select demand_test.check((select count(*) = 1 from core.demand_submission where submission_id = :'mkt_sub'), 'S10 SCM 품목담당자(PLAN_CONFIRM)는 모든 부서 제출본을 본다');
select demand_test.as_user(:'admin1') \g /dev/null
select demand_test.check((select count(*) = 1 from core.demand_submission where submission_id = :'mkt_sub'), 'S10 ADMIN도 모든 부서 제출본을 본다');
reset role;

\echo '== S11 이력 append-only, 동일 부서·기준월 활성 제출본 유일성 =='
select demand_test.expect_error(
  format('update core.demand_submission_event set reason = %L where submission_id = %L and event_type = %L', '변조', :'mkt_sub', 'SUBMITTED'),
  '수요 제출 이력은 수정하거나 삭제할 수 없습니다', 'S11 이벤트 이력 UPDATE 거절');
select demand_test.expect_error(
  format('delete from core.demand_submission_event where submission_id = %L', :'mkt_sub'),
  '수요 제출 이력은 수정하거나 삭제할 수 없습니다', 'S11 이벤트 이력 DELETE 거절');
select demand_test.check((select count(*) from core.demand_submission where cycle_id = :'future_cycle' and department = 'MARKETING') = 1,
  'S11 동일 부서·기준월(future)의 활성 제출본은 하나뿐이다(unique 제약)');
select demand_test.check((select count(*) from core.demand_submission group by cycle_id, department having count(*) > 1) is null,
  'S11 어떤 부서·기준월 조합도 활성 제출본이 둘 이상 없다');

\echo '== S12 취합 주기 닫기·재개 =='
set role authenticated;
select demand_test.as_user(:'planner1') \g /dev/null
select core.close_planning_cycle(:'future_cycle') \g /dev/null
select demand_test.expect_error(format('select core.close_planning_cycle(%L)', :'future_cycle'), '열려 있는 취합 주기를 찾을 수 없습니다', 'S12 이미 닫힌 주기를 다시 닫으면 거절');
select core.open_planning_cycle(:'future_month'::date) as future_cycle_2 \gset
select demand_test.check(:'future_cycle_2' is not null and :'future_cycle_2' <> :'future_cycle', 'S12 닫힌 달은 새 취합 주기로 다시 열 수 있다');
reset role;
select demand_test.check((select not is_active and status = 'CLOSED' from core.planning_cycle where cycle_id = :'future_cycle'), 'S12 닫힌 주기는 CLOSED · is_active=false로 남는다(이력 보존)');
