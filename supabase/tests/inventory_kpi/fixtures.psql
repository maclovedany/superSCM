on conflict (id) do nothing;

insert into core.app_user (user_id, email, name, department, role, active, job_role) values
  ('00000000-0000-4000-8000-000000000401', 't12-planner1@example.test', 'SCM품목담당1', 'SCM', 'USER', true, 'SCM_PLANNER'),
  ('00000000-0000-4000-8000-000000000402', 't12-lead1@example.test', 'SCM팀장1', 'SCM', 'USER', true, 'SCM_LEAD'),
