-- 품목 4개 — 각각 다른 사유 코드 시나리오 전용.
--   ITEMT1201  한 번도 분류된 적 없음(core.stock_balance 행 자체가 없다) → INVENTORY_SCOPE_UNCLASSIFIED
--   ITEMT1202  분류는 되지만(과거 스냅샷 있음) 승인 단가·목표재고 흐름 검증 전용
--   ITEMT1203  분류는 되지만(core.stock_balance 행 있음) 검증 대상 달(2026-09)에는 스냅샷이 없음 → MONTH_END_SNAPSHOT_MISSING
--   ITEMT1204  core.apply_month_end_inventory_snapshot_from_batch 함수 자체(raw.inventory → 분류 → upsert) 검증 전용
--   ITEMT1205  월 경계 timezone 검증 전용(세션 timezone과 무관하게 'Asia/Seoul' 벽시계로 달을 정하는지)
insert into raw.item_master ("품목코드", "품목명", "품목구분") values
  ('ITEMT1201', 'T12 미분류 품목', '소모품'),
  ('ITEMT1202', 'T12 승인 흐름 품목', '소모품'),
  ('ITEMT1203', 'T12 이달 스냅샷 없음', '소모품'),
  ('ITEMT1204', 'T12 배치 함수 검증', '소모품'),
  ('ITEMT1205', 'T12 월 경계 timezone 검증', '소모품')
on conflict do nothing;

