-- ITEMT1202 · ITEMT1203은 "한 번은 NORMAL로 분류된 적 있다"는 사실만 필요하므로
-- core.stock_balance에 슈퍼유저로 직접 행을 넣는다(procurement_plan 테스트 스위트와 같은 방식).
insert into core.stock_balance (item_id, snapshot_qty, normal_qty, snapshot_at) values
  ('ITEMT1202', 120, 120, '2026-09-28T00:00:00Z'),
  ('ITEMT1203', 80, 80, '2026-08-30T00:00:00Z')
on conflict (item_id) do update set snapshot_qty = excluded.snapshot_qty, normal_qty = excluded.normal_qty, snapshot_at = excluded.snapshot_at;

-- ITEMT1202의 2026-09 월말 스냅샷 — v_inventory_performance가 그대로 읽을 값.
insert into core.month_end_inventory_snapshot (plan_month, item_id, normal_qty, snapshot_at) values
  ('2026-09-01', 'ITEMT1202', 120, '2026-09-28T00:00:00Z')
on conflict (plan_month, item_id) do update set normal_qty = excluded.normal_qty, snapshot_at = excluded.snapshot_at;

-- ITEMT1203은 2026-08에는 스냅샷이 있지만(위 stock_balance와 짝) 2026-09에는 없다 — 의도된 결측.
insert into core.month_end_inventory_snapshot (plan_month, item_id, normal_qty, snapshot_at) values
  ('2026-08-01', 'ITEMT1203', 80, '2026-08-30T00:00:00Z')
on conflict (plan_month, item_id) do update set normal_qty = excluded.normal_qty, snapshot_at = excluded.snapshot_at;

