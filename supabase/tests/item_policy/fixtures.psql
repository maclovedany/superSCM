  ('00000000-0000-4000-8000-000000000305', 't9-admin1@example.test'),
  -- ITEM_POLICY_EDIT와 ITEM_POLICY_APPROVE를 동시에 가진 합성 계정 — "요청자 본인은 승인할 수
  -- 없다" 검증 전용이다(실제 직책 중에는 두 권한을 함께 가진 직책이 없다 — 역할 분리가 이미
  -- 이를 막는다. supabase/tests/approved_demand의 T8_DUAL_ROLE과 같은 목적).
  ('00000000-0000-4000-8000-000000000306', 't9-dualrole1@example.test')
on conflict (id) do nothing;

