-- 품목 정책 변경·승인 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists itempolicy_test;
grant usage on schema itempolicy_test to anon, authenticated;

create or replace function itempolicy_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function itempolicy_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function itempolicy_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

grant execute on all functions in schema itempolicy_test to anon, authenticated;

insert into auth.users (id, email) values
  ('00000000-0000-4000-8000-000000000301', 't9-planner1@example.test'),
  ('00000000-0000-4000-8000-000000000302', 't9-planner2@example.test'),
  ('00000000-0000-4000-8000-000000000303', 't9-lead1@example.test'),
  ('00000000-0000-4000-8000-000000000304', 't9-marketing1@example.test'),
  ('00000000-0000-4000-8000-000000000305', 't9-admin1@example.test'),
  -- ITEM_POLICY_EDIT와 ITEM_POLICY_APPROVE를 동시에 가진 합성 계정 — "요청자 본인은 승인할 수
  -- 없다" 검증 전용이다(실제 직책 중에는 두 권한을 함께 가진 직책이 없다 — 역할 분리가 이미
  -- 이를 막는다. supabase/tests/approved_demand의 같은 목적 계정과 동일한 패턴).
  ('00000000-0000-4000-8000-000000000306', 't9-dualrole1@example.test')
on conflict (id) do nothing;

-- ★ Task 17 리뷰 fix round 1(정정) — 20260912000300(관리자 계정 관리)이 core.app_user.job_role에
--   실제 직책 목록만 허용하는 체크 제약을 걸어서, 이 fixture가 오래전부터 써 온 테스트 전용
--   가상 직책(예: T9_DUAL_ROLE)을 더 이상 넣을 수 없게 됐다(이 로컬 환경에서는 pg_cron 가드
--   부재로 가려져 있다가 그 가드를 추가한 지금 처음 드러났다 — error.md #35). 1차 초안은
--   운영 제약을 임시 DB에서 완화했는데, **그럴 필요가 없었다** — core.role_permission.job_role
--   에는 CHECK·FK가 없어(20260911000200_step19_permission.sql) 이중 권한 역할을 만드는
--   것 자체는 이미 합법이고, 불법인 것은 그 합성 이름을 app_user에 배정하는 것뿐이다. 그래서
--   합성 직책 대신 **이 스위트가 쓰지 않는 실제 직책 BIZ_DEV**에 이 두 권한을 시험 전용으로
--   얹는다(제약을 전혀 건드리지 않는다). 아래 S6("한 계정이 두 권한을 동시에 가질 때 자기
--   승인이 막히는가")은 역할 이름과 무관하게 성립한다 — 사용자 uuid(dualrole1)로만 참조한다.
insert into core.app_user (user_id, email, name, department, role, active, job_role) values
  ('00000000-0000-4000-8000-000000000301', 't9-planner1@example.test', 'SCM품목담당1', 'SCM', 'USER', true, 'SCM_PLANNER'),
  ('00000000-0000-4000-8000-000000000302', 't9-planner2@example.test', 'SCM품목담당2', 'SCM', 'USER', true, 'SCM_PLANNER'),
  ('00000000-0000-4000-8000-000000000303', 't9-lead1@example.test', 'SCM팀장1', 'SCM', 'USER', true, 'SCM_LEAD'),
  ('00000000-0000-4000-8000-000000000304', 't9-marketing1@example.test', '마케팅1', 'MARKETING', 'USER', true, 'MARKETING'),
  ('00000000-0000-4000-8000-000000000305', 't9-admin1@example.test', '관리자1', null, 'ADMIN', true, null),
  -- ★ BIZ_DEV는 이 스위트의 다른 어떤 계정도 쓰지 않는다 — 품목 정책 권한과 무관한 실제
  --   직책이지만, "요청자 본인 승인 차단" 시나리오는 권한 조합만 필요하고 직책 의미와는
  --   무관하므로 시험 전용으로 빌려 쓴다(운영 role_permission 시드는 건드리지 않는다 —
  --   아래 INSERT는 이 임시 DB에만 존재한다).
  ('00000000-0000-4000-8000-000000000306', 't9-dualrole1@example.test', '겸직테스트', 'SCM', 'USER', true, 'BIZ_DEV')
on conflict (user_id) do update
  set job_role = excluded.job_role, department = excluded.department, role = excluded.role, name = excluded.name, active = true;

insert into core.role_permission (job_role, permission_code) values
  ('BIZ_DEV', 'ITEM_POLICY_EDIT'),
  ('BIZ_DEV', 'ITEM_POLICY_APPROVE')
on conflict (job_role, permission_code) do nothing;

