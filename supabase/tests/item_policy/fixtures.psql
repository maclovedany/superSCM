  ('ITEMT901', null, null, 'A', 0.95),
  ('ITEMT902', 30, 6, 'B', 0.9),
  ('ITEMT903', null, null, 'A', 0.95),
  ('ITEMT904', null, null, 'A', 0.95)
on conflict (item_id) do update set moq = excluded.moq, pack_size = excluded.pack_size;

select 'fixtures ok';
