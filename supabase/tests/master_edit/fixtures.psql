insert into core.supply_entity (entity_id, entity_name, country_code, prep_days, active, note) values
  ('T10', 'T10 검증 법인', 'T1', 0, true, 'Task 10a 검증 전용')
on conflict (entity_id) do update set prep_days = 0, active = true, valid_to = null;

insert into core.supplier (supplier_id, supplier_name, entity_id, lead_time_days, active) values
  ('SUP-T10-1', 'T10 검증 공급처1', 'T10', 10, true)
on conflict (supplier_id) do update set entity_id = 'T10', active = true, valid_to = null;

