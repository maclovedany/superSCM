-- Task 10a 관리자 마스터 편집 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists masteredit_test;
grant usage on schema masteredit_test to anon, authenticated;

create or replace function masteredit_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function masteredit_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function masteredit_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

grant execute on all functions in schema masteredit_test to anon, authenticated;

insert into auth.users (id, email) values
  ('00000000-0000-4000-8000-000000000401', 't10-admin1@example.test'),
  ('00000000-0000-4000-8000-000000000402', 't10-user1@example.test')
on conflict (id) do nothing;

insert into core.app_user (user_id, email, name, department, role, active) values
  ('00000000-0000-4000-8000-000000000401', 't10-admin1@example.test', '관리자1', null, 'ADMIN', true),
  ('00000000-0000-4000-8000-000000000402', 't10-user1@example.test', '일반사용자1', 'SCM', 'USER', true)
on conflict (user_id) do update
  set role = excluded.role, active = true, name = excluded.name;

