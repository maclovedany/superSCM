-- 실습용 데이터 표식·제거(Task 15) 검증 fixture — 로컬 임시 DB(scm_test_*) 전용.
--
-- ★ 이 fixture의 핵심은 **실데이터 대역과 실습 데이터를 나란히 두는 것**이다. 제거 절차가
--   실습 행만 지우고 실데이터 행은 한 줄도 건드리지 않는다는 것을 증명하려면 둘 다 있어야 한다.
--
--   실데이터 대역 — batch_id가 null이다(배포 DB의 5회차 더미 · 실데이터와 같은 모양).
--     raw.dim_item DIMREAL1·DIMREAL2 · raw.item_master REALT001 · raw.usage_history 3행
--     core.item_policy REALT001 · core.stock_balance REALT001 · core.supplier REAL-SUP
--
--   실습 데이터 — 전부 등기부에 올라간다.
--     품목 PRCT001~003 · 적재 배치 2개 · 정책 3건 · 재고 · 월말 스냅샷 · 취합 주기 ·
--     공급처 PRC-T15 · 법인 JP 준비기간 변경 · Forecast 설정
--
--   ★ PRCT003에는 긴급발주(core.urgent_order)를 하나 달아 둔다 — "사람이 이미 업무를 한 품목"을
--     제거가 어떻게 다루는지(지우지 않고 blocked로 보고) 검증하기 위한 것이다.

\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists practice_test;
grant usage on schema practice_test to anon, authenticated;

create or replace function practice_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function practice_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function practice_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

-- 제거 전후 실데이터 건수를 비교하기 위한 기준선 저장소.
create table if not exists practice_test.baseline (name text primary key, n bigint);
create table if not exists practice_test.remove_result (result jsonb);

grant execute on all functions in schema practice_test to anon, authenticated;

