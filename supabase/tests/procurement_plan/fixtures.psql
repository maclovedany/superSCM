-- 운영값은 Task 9a 승인 절차로만 넣는다(요청 → 팀장 승인).
set role authenticated;
select plan_test.as_user('00000000-0000-4000-8000-000000000401') \g /dev/null
select core.request_item_policy_change('T9B01', 30, 'AUTO', null, 1000, 50, null, null, 'T9B fixture') as rev1 \gset
select core.request_item_policy_change('T9B02', 30, 'AUTO', null, 1000, null, null, null, 'T9B fixture') as rev2 \gset
select core.request_item_policy_change('T9B03', 30, 'AUTO', null, 200, null, null, null, 'T9B fixture') as rev3 \gset
-- 목표 DoS를 제안하지 않는다 — 단가만 승인되고 목표 DoS는 미설정으로 남는다.
select core.request_item_policy_change('T9B04', null, 'AUTO', null, 500, null, null, null, 'T9B fixture') as rev4 \gset
reset role;

set role authenticated;
select plan_test.as_user('00000000-0000-4000-8000-000000000403') \g /dev/null
select core.decide_approval(r.approval_id, 'APPROVED', 'fixture 승인')
  from core.item_policy_revision r
 where r.revision_id in (:'rev1', :'rev2', :'rev3', :'rev4') \g /dev/null
reset role;

