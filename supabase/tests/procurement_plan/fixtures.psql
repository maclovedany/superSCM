  ('00000000-0000-4000-8000-000000000404', 't9b-marketing1@example.test', '마케팅1', 'MARKETING', 'USER', true, 'MARKETING'),
  ('00000000-0000-4000-8000-000000000405', 't9b-admin1@example.test', '관리자1', null, 'ADMIN', true, null),
  -- ★ BIZ_DEV는 이 스위트의 다른 어떤 계정도 쓰지 않는다 — 시험 전용으로 빌려 쓴다(운영
  --   role_permission 시드는 건드리지 않는다 — 아래 INSERT는 이 임시 DB에만 존재한다).
