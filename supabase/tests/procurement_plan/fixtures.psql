-- 발주계획 계산·승인 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
--
-- ★ 원천 게이트(컨트롤러 판정 1)를 통과하는 "검증된 출처" 데이터를 만든다: 학습 기간의 모든
--   raw.usage_history 행이 IMPORTED usage_history 적재 배치(core.upload_batch)와 FILE_UPLOAD 출처를
--   가진다. Forecast Run · Backtest · Champion은 실행 함수를 다시 돌리지 않고 결과 행을 직접 넣는다
--   (계산 규칙 검증에 필요한 값을 정확히 고정하기 위해서다).
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists plan_test;
grant usage on schema plan_test to anon, authenticated;

create or replace function plan_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function plan_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function plan_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

-- 계획 한 건의 한 품목 라인 계산값을 한 문자열로 모은다 — "바뀌지 않았다"를 비교할 때 쓴다.
create or replace function plan_test.line_signature(p_plan_id uuid, p_item_id text) returns text language sql as $$
  select string_agg(
    concat_ws('|', month_no, base_forecast_qty, avg_usage_6m, candidate_qty, adjusted_demand_qty, demand_qty,
              start_stock_qty, selected_qty, final_order_qty, projected_month_end_qty, projected_dos_days,
              projected_inventory_value, calculation_status, reason_code),
    ';' order by month_no)
  from core.procurement_plan_line where plan_id = p_plan_id and item_id = p_item_id
$$;

grant execute on all functions in schema plan_test to anon, authenticated;

