insert into raw.usage_history (usage_id, item_id, use_date, qty, warehouse, batch_id, source_type, loaded_at, source_record_id)
select 'T9B-' || i.item_id || '-' || to_char(m.month, 'YYYYMM'), i.item_id, (m.month + 14)::date,
       -- T9B02는 합 603(평균 100.5), T9B04는 합 100(평균 16.666… 반복소수 — fix round 1 정밀도 검증)
       case when i.item_id = 'T9B02' and m.month = '2026-06-01' then 103
            when i.item_id = 'T9B04' then case when extract(month from m.month) in (1, 4) then 16 else 17 end
            else 100 end,
       'MAIN', '00000000-0000-4000-8000-0000000004b1', 'FILE_UPLOAD', '2026-07-01T00:00:00Z',
       'T9B-' || i.item_id || '-' || to_char(m.month, 'YYYYMM')
  from (values ('T9B01'), ('T9B02'), ('T9B03'), ('T9B04')) as i(item_id)
 cross join (select generate_series('2026-01-01'::timestamp, '2026-06-01'::timestamp, interval '1 month')::date as month) m;

