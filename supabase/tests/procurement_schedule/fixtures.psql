-- ══ 승인된 발주계획 — Task 9b 확정 · 승인 함수와 같은 최종 상태를 직접 만든다 ══
--
-- (계산 · 확정 · 승인 파이프라인 자체는 supabase/tests/procurement_plan에서 이미 검증했다. 여기서는
-- Task 10b가 읽는 "승인된 계획 + 1개월차 라인"이라는 전제만 재현한다.)

-- fix round 1 — p_version을 받는다. 같은 달에 버전이 다른 APPROVED 계획을 여러 개 만들어
-- "최신 승인본만 허용" · "옛 승인본 일정은 superseded로 남는다"를 검증한다(Task 9b는 새 버전이 생겨도
-- 이미 APPROVED인 계획을 SUPERSEDED로 바꾸지 않으므로 실제로 한 달에 APPROVED가 여러 개 있을 수 있다).
create or replace function sched_test.make_approved_plan(
  p_plan_month date, p_items text[], p_qtys numeric[], p_version integer default 1
) returns uuid language plpgsql as $$
declare
  v_plan_id uuid;
  v_approval_id uuid;
  v_i int;
begin
  insert into core.procurement_plan (
    plan_month, version, status, source_status, built_by, built_by_name
  ) values (
    p_plan_month, p_version, 'DRAFT', 'VERIFIED', '00000000-0000-4000-8000-000000000501'::uuid, 'SCM품목담당1'
  ) returning plan_id into v_plan_id;

  for v_i in 1..array_length(p_items, 1) loop
    insert into core.procurement_plan_line (
      plan_id, item_id, month_no, target_month,
      start_stock_qty, demand_qty, stockout_prevention_qty, dos_required_qty, selected_qty, selection_reason,
      effective_moq, final_order_qty, projected_month_end_qty, projected_inventory_value,
      calculation_status, reason_code, reason_codes
    ) values (
      v_plan_id, p_items[v_i], 1, p_plan_month,
      0, p_qtys[v_i], p_qtys[v_i], p_qtys[v_i], p_qtys[v_i], 'DOS_TARGET',
      1, p_qtys[v_i], 0, 0,
      'CALCULATED', null, '{}'
    );
  end loop;

  update core.procurement_plan
     set status = 'PENDING_APPROVAL', confirmed_by = '00000000-0000-4000-8000-000000000501'::uuid,
         confirmed_by_name = 'SCM품목담당1', confirmed_at = clock_timestamp()
   where plan_id = v_plan_id;

  insert into core.approval_request (approval_type, target_type, target_id, requested_by, requester_name)
  values ('PURCHASE_PLAN', 'PROCUREMENT_PLAN', v_plan_id::text, '00000000-0000-4000-8000-000000000501'::uuid, 'SCM품목담당1')
  returning approval_id into v_approval_id;

  update core.procurement_plan set approval_id = v_approval_id where plan_id = v_plan_id;

  update core.approval_request
     set status = 'APPROVED', decided_by = '00000000-0000-4000-8000-000000000502'::uuid,
         decider_name = 'SCM팀장1', decided_at = clock_timestamp()
   where approval_id = v_approval_id;

  return v_plan_id;
end;
$$;

select sched_test.make_approved_plan(
  '2026-11-01'::date,
  array['T10BITM1','T10BITM2','T10BITM3','T10BITM4','T10BITM5','T10BITM6','T10BITM9','T10BITM10'],
  array[100,50,30,40,60,70,20,10]::numeric[]
) as plan_nov \gset

select sched_test.make_approved_plan('2026-08-01'::date, array['T10BITM7'], array[15]::numeric[]) as plan_aug \gset
select sched_test.make_approved_plan('2026-12-01'::date, array['T10BITM8'], array[25]::numeric[]) as plan_dec \gset

