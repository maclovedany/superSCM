values ('2026-07-01'::date, 1, 'DRAFT', 'VERIFIED', :'planner1'::uuid, 'SCM품목담당1')
returning plan_id as plan_pending \gset
update core.procurement_plan
   set status = 'PENDING_APPROVAL', confirmed_by = :'planner1'::uuid, confirmed_by_name = 'SCM품목담당1', confirmed_at = clock_timestamp()
 where plan_id = :'plan_pending';

