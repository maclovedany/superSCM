-- Task 10b 발주 일정 · 입고 차이 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
--
-- ★ 마스터 데이터(core.supply_entity · core.supplier · core.supplier_departure ·
--   core.business_calendar_readiness)와 승인된 발주계획(core.procurement_plan/_line)은 여기서
--   직접(슈퍼유저) 만든다 — Task 10a 관리자 함수와 Task 9b 확정 · 승인 함수는 각자 스위트에서
--   이미 검증됐다. 여기서 만드는 계획 행은 그 함수들이 만드는 것과 똑같은 제약(가드 트리거 · CHECK)을
--   그대로 통과하는 최종 상태다 — 다만 confirm/approve 단계를 실제 세션으로 거치지 않고 한 번에 만든다.
-- ★ 12개월 준비기간이 있는 실제 5개 법인(JP·CN·VN·SG·NL)은 STEP 18이 이미 심어 둔 그대로(prep_days=0)
--   써서 "준비기간 현업 확인 전" 상태에서 PREP_DAYS_UNSET이 실제로 재현되는지 보여준다(memory:
--   realdata-has-no-inventory-or-leadtime와 같은 결의 검증).
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists sched_test;
grant usage on schema sched_test to anon, authenticated;

create or replace function sched_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function sched_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function sched_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

grant execute on all functions in schema sched_test to anon, authenticated;

