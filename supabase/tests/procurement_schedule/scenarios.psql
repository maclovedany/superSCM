-- Task 10b 발주 일정 · 입고 차이 — 검증 시나리오. 로컬 임시 DB(scm_test_*) 전용, fixtures.psql 적용 뒤 실행.
-- 구조는 master_edit · procurement_plan과 같다: 사용자 컨텍스트가 필요한 구간은 `set role authenticated`
-- (진짜 RLS · GRANT 적용) 안에서 as_user()로 auth.uid()를 지정하고, 결과 확인은 `reset role`(슈퍼유저) 뒤
-- analytics 뷰를 직접 읽어 판정한다.
\set ON_ERROR_STOP 1
\ir guard.psql
\pset tuples_only on
\pset format unaligned

\set planner1 '00000000-0000-4000-8000-000000000501'
\set lead1 '00000000-0000-4000-8000-000000000502'
\set marketing1 '00000000-0000-4000-8000-000000000503'

select plan_id as plan_nov from core.procurement_plan where plan_month = '2026-11-01' \gset
select plan_id as plan_aug from core.procurement_plan where plan_month = '2026-08-01' \gset
select plan_id as plan_dec from core.procurement_plan where plan_month = '2026-12-01' \gset
select plan_id as plan_draft from core.procurement_plan where plan_month = '2026-06-01' \gset
select plan_id as plan_pending from core.procurement_plan where plan_month = '2026-07-01' \gset


\echo '== S1 core.build_procurement_schedule — 권한 없는 사용자는 거절된다 =='
set role authenticated;
select sched_test.as_user(:'marketing1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.build_procurement_schedule(%L)$f$, :'plan_nov'),
  '발주 일정 생성 권한', 'S1 MARKETING(권한 없음)은 발주 일정을 만들 수 없다'
);
reset role;
set role authenticated;
select sched_test.as_user(:'lead1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.build_procurement_schedule(%L)$f$, :'plan_nov'),
  '발주 일정 생성 권한', 'S1 PLAN_APPROVE만 가진 사용자는 발주 일정을 만들 수 없다(PLAN_CONFIRM 필요)'
);
reset role;


\echo '== S2 core.build_procurement_schedule — 승인되지 않은 계획은 거절된다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.build_procurement_schedule(%L)$f$, :'plan_draft'),
  '승인된 발주계획만.*현재 DRAFT', 'S2 DRAFT 계획은 거절된다'
);
select sched_test.expect_error(
  format($f$select core.build_procurement_schedule(%L)$f$, :'plan_pending'),
  '승인된 발주계획만.*현재 PENDING_APPROVAL', 'S2 PENDING_APPROVAL 계획은 거절된다'
);
select sched_test.expect_error(
  $f$select core.build_procurement_schedule('11111111-1111-4111-8111-111111111111')$f$,
  '발주계획을 찾을 수 없습니다', 'S2 존재하지 않는 계획은 거절된다'
);
reset role;


\echo '== S3 core.build_procurement_schedule — 승인된 계획(11월)을 만들면 1개월차 · 발주량>0 라인 수만큼 일정이 생긴다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s3_returned from core.build_procurement_schedule(:'plan_nov') \g /dev/null
reset role;
select sched_test.check(
  (select count(*) from core.procurement_schedule where plan_id = :'plan_nov') = 8,
  'S3 11월 계획 8개 라인 전부 일정 행이 생긴다(조용히 빠지지 않는다)'
);
select sched_test.check(
  (select count(distinct plan_line_id) from core.procurement_schedule where plan_id = :'plan_nov') = 8,
  'S3 plan_line_id마다 정확히 한 행(중복 없음)'
);


\echo '== S4 정상 계산(T10BITM1) — 출항일 · 기준/요청 발주일 · 계획/확정 입고일이 브리프 공식대로 나온다 =='
-- 공급처(SUP-T10B-1, 매월 20일 출항) · 법인(T10B, 준비기간 7일) · 2026-11-20을 KR 공휴일로 등록(fixtures).
-- 기준 발주일 11/13(금, 평일) → 요청 발주일 그대로 → 계획 입고일 11/20(금, 공휴일) → 확정 계획 입고일 11/19(목).
select departure_date as s4_dep, prep_days as s4_prep, base_order_date as s4_base,
       requested_order_date as s4_req, planned_receipt_date as s4_planned, confirmed_receipt_date as s4_conf,
       bundle_iso_year as s4_iy, bundle_iso_week as s4_iw, bundle_key as s4_bk,
       calculation_status as s4_status, gap_reason_code as s4_gap_reason
  from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM1' \gset
select sched_test.check(:'s4_dep' = '2026-11-20', 'S4 출항일 = 공급처 규칙(매월 20일)');
select sched_test.check(:s4_prep = 7, 'S4 준비기간 스냅샷');
select sched_test.check(:'s4_base' = '2026-11-13', 'S4 기준 발주일 = 출항일 − 준비기간');
select sched_test.check(:'s4_req' = '2026-11-13', 'S4 요청 발주일 = 기준 발주일(평일이라 조정 없음)');
select sched_test.check(:'s4_planned' = '2026-11-20', 'S4 계획 입고일 = 요청 발주일 + 7일');
select sched_test.check(:'s4_conf' = '2026-11-19', 'S4 확정 계획 입고일 = 계획 입고일이 공휴일(금)이라 목요일로 이전 영업일 조정');
select sched_test.check(:s4_iy = 2026 and :s4_iw = 47, 'S4 출항일의 ISO 주차로 묶인다(2026-W47)');
select sched_test.check(:'s4_bk' = '2026-W47', 'S4 묶음 키 문자열');
select sched_test.check(
  (select calculation_status = 'SCHEDULED' and reason_code is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM1'),
  'S4 계산 상태 SCHEDULED · 사유 없음'
);
select sched_test.check(:'s4_gap_reason' = 'ACTUAL_RECEIPT_UNSET', 'S4 실제 입고일 입력 전에는 gap_reason_code가 ACTUAL_RECEIPT_UNSET');


\echo '== S5 주말 조정(T10BITM9) — 기준 발주일이 일요일이면 그 전 금요일로, 입고일은 조정 없이 그대로 =='
-- 공급처(SUP-T10B-6, 매주 월요일) · 법인(T10B2, 준비기간 1일). 11/2(월) 출항 − 1일 = 11/1(일) → 10/30(금).
select departure_date as s5_dep, base_order_date as s5_base, requested_order_date as s5_req,
       planned_receipt_date as s5_planned, confirmed_receipt_date as s5_conf
  from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM9' \gset
select sched_test.check(:'s5_dep' = '2026-11-02', 'S5 출항일(첫 월요일)');
select sched_test.check(:'s5_base' = '2026-11-01', 'S5 기준 발주일(일요일)');
select sched_test.check(:'s5_req' = '2026-10-30', 'S5 요청 발주일 — 주말이라 이전 영업일(10월로 달을 넘긴다)');
select sched_test.check(:'s5_planned' = '2026-11-06', 'S5 계획 입고일 = 요청 발주일 + 7일');
select sched_test.check(:'s5_conf' = '2026-11-06', 'S5 확정 계획 입고일 — 평일이라 조정 없음');


\echo '== S6 SUPPLIER_UNSET — 품목에 공급처 매핑이 없거나(T10BITM2) 존재하지 않는 코드면(T10BITM10) =='
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'SUPPLIER_UNSET' and departure_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM2'),
  'S6 공급처 매핑 자체가 없는 품목(T10BITM2) → SUPPLIER_UNSET · 출항일 없음'
);
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'SUPPLIER_UNSET'
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM10'),
  'S6 존재하지 않는 공급처 코드(T10BITM10) → SUPPLIER_UNSET'
);


\echo '== S7 DEPARTURE_RULE_UNSET — 출항일 규칙이 하나도 없으면(T10BITM3) =='
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'DEPARTURE_RULE_UNSET' and departure_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM3'),
  'S7 규칙 없음 → DEPARTURE_RULE_UNSET'
);


\echo '== S8 DEPARTURE_RULE_AMBIGUOUS — 활성 규칙이 같은 날 두 개 겹치면(T10BITM4) 고르지 않는다 =='
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'DEPARTURE_RULE_AMBIGUOUS' and departure_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM4'),
  'S8 규칙 중복 → DEPARTURE_RULE_AMBIGUOUS · 출항일을 고르지 않는다'
);


\echo '== S9 SUPPLIER_INACTIVE — 출항일 기준 공급처 적용 기간이 끝났으면(T10BITM5) 출항일은 남긴다 =='
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'SUPPLIER_INACTIVE' and departure_date = '2026-11-20' and requested_order_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM5'),
  'S9 공급처 적용기간(~2026-10-31) 밖 → SUPPLIER_INACTIVE, 출항일 자체는 계산돼 남는다'
);


\echo '== S10 PREP_DAYS_UNSET — 해외법인 준비기간이 0(미확인)이면(T10BITM6, 실제 JP) 발주일을 계산하지 않는다 =='
select sched_test.check(
  (select prep_days from core.supply_entity where entity_id = 'JP') = 0,
  'S10 사전 조건 — JP는 STEP 18 시드값(준비기간 0=미확인)을 그대로 쓴다'
);
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'PREP_DAYS_UNSET' and departure_date = '2026-11-20'
       and entity_id = 'JP' and base_order_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM6'),
  'S10 JP 준비기간 미확인 → PREP_DAYS_UNSET, 출항일 · 법인은 남고 발주일은 없다'
);


\echo '== S11 CALENDAR_NOT_READY — KR 달력이 준비 안 된 달(8월)이면 주말만으로 추정하지 않는다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s11_returned from core.build_procurement_schedule(:'plan_aug') \g /dev/null
reset role;
select sched_test.check(
  not exists (select 1 from core.business_calendar_readiness where country_code = 'KR' and cal_year = 2026 and cal_month = 8),
  'S11 사전 조건 — 8월은 준비됨으로 표시하지 않았다'
);
select sched_test.check(
  (select calculation_status = 'EXCLUDED' and reason_code = 'CALENDAR_NOT_READY' and departure_date = '2026-08-20'
       and base_order_date = '2026-08-13' and requested_order_date is null and confirmed_receipt_date is null
     from analytics.v_procurement_schedule where plan_id = :'plan_aug' and item_id = 'T10BITM7'),
  'S11 8월(미준비) → CALENDAR_NOT_READY, 출항일 · 기준 발주일은 남고 그 뒤 값은 없다'
);


\echo '== S12 연 경계 ISO 주차 — 12/31 출항이면 2026-W53으로 묶이고 정상 계산된다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s12_returned from core.build_procurement_schedule(:'plan_dec') \g /dev/null
reset role;
select departure_date as s12_dep, base_order_date as s12_base, requested_order_date as s12_req,
       planned_receipt_date as s12_planned, confirmed_receipt_date as s12_conf,
       bundle_iso_year as s12_iy, bundle_iso_week as s12_iw, calculation_status as s12_status
  from analytics.v_procurement_schedule where plan_id = :'plan_dec' and item_id = 'T10BITM8' \gset
select sched_test.check(:'s12_dep' = '2026-12-31', 'S12 출항일(매월 31일 규칙, 12월)');
select sched_test.check(:s12_iy = 2026 and :s12_iw = 53, 'S12 2026-12-31은 ISO 주차 2026-W53(연 경계)');
select sched_test.check(:'s12_base' = '2026-12-24' and :'s12_req' = '2026-12-24', 'S12 기준 · 요청 발주일(평일)');
select sched_test.check(:'s12_planned' = '2026-12-31' and :'s12_conf' = '2026-12-31', 'S12 계획 · 확정 입고일(평일, 조정 없음)');
select sched_test.check(:'s12_status' = 'SCHEDULED', 'S12 정상 계산됨');


\echo '== S13 재실행(idempotent) — 행이 늘지 않고 사유 · 날짜가 그대로다 =='
select count(*) as s13_before from core.procurement_schedule where plan_id = :'plan_nov' \gset
select schedule_id as s13_sched_before from core.procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM1' \gset
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s13_returned from core.build_procurement_schedule(:'plan_nov') \g /dev/null
reset role;
select count(*) as s13_after from core.procurement_schedule where plan_id = :'plan_nov' \gset
select schedule_id as s13_sched_after from core.procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM1' \gset
select sched_test.check(:s13_before = :s13_after, 'S13 재실행해도 행 수가 늘지 않는다');
select sched_test.check(:'s13_sched_before' = :'s13_sched_after', 'S13 같은 plan_line_id는 같은 schedule_id를 유지한다(새로 만들지 않는다)');


\echo '== S14 실제 입고일 입력(PLAN_CONFIRM) — 입고 차이가 부호 있는 일수로 저장된다 =='
select schedule_id as s14_sched from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM1' \gset
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select core.record_actual_receipt_date(:'s14_sched', '2026-11-21', '검수 완료(2일 지연)') \g /dev/null
reset role;
select actual_receipt_date as s14_actual, gap_days as s14_gap, recorded_by_name as s14_recorder
  from analytics.v_procurement_schedule where schedule_id = :'s14_sched' \gset
select sched_test.check(:'s14_actual' = '2026-11-21', 'S14 실제 입고일이 저장된다');
select sched_test.check(:s14_gap = 2, 'S14 입고 차이 = 실제(11/21) − 확정 계획(11/19) = 2(지연, 양수)');
select sched_test.check(
  (select gap_reason_code is null from analytics.v_procurement_schedule where schedule_id = :'s14_sched'),
  'S14 실제 입고일이 있으면 gap_reason_code가 없다'
);
select sched_test.check(:'s14_recorder' = 'SCM품목담당1', 'S14 입력자 이름이 기록된다');
select sched_test.check(
  exists (select 1 from core.audit_log where target_type = 'receipt_schedule_result' and target_id = :'s14_sched'
            and action = 'RECEIPT_ACTUAL_DATE_RECORDED' and (after ->> 'actual_receipt_date') = '2026-11-21'),
  'S14 입력 이력이 append-only(core.audit_log)에 남는다'
);

\echo '== S14b 조기 입고(음수) — 11/2에 확정 계획(11/19)보다 먼저 입고되면 음수로 저장된다(별도 상태 코드 없음) =='
select schedule_id as s14b_sched from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM9' \gset
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select core.record_actual_receipt_date(:'s14b_sched', '2026-11-04', null) \g /dev/null
reset role;
select gap_days as s14b_gap from analytics.v_procurement_schedule where schedule_id = :'s14b_sched' \gset
select sched_test.check(:s14b_gap = -2, 'S14b 조기 입고는 음수(11/4 − 11/6 = −2), 조기/지연 상태 코드는 없다(수치만)');


\echo '== S15 재실행 뒤에도 실제 입고일이 보존된다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s15_returned from core.build_procurement_schedule(:'plan_nov') \g /dev/null
reset role;
select actual_receipt_date as s15_actual, gap_days as s15_gap from analytics.v_procurement_schedule where schedule_id = :'s14_sched' \gset
select sched_test.check(:'s15_actual' = '2026-11-21' and :s15_gap = 2, 'S15 재실행 후에도 실제 입고일 · 차이가 그대로다');


\echo '== S16 실제 입고일 null이면 차이도 null이고 사유는 ACTUAL_RECEIPT_UNSET이다 =='
select schedule_id as s16_sched from analytics.v_procurement_schedule where plan_id = :'plan_dec' and item_id = 'T10BITM8' \gset
select sched_test.check(
  (select actual_receipt_date is null and gap_days is null and gap_reason_code = 'ACTUAL_RECEIPT_UNSET'
     from analytics.v_procurement_schedule where schedule_id = :'s16_sched'),
  'S16 실제 입고일을 아직 입력하지 않은 SCHEDULED 행은 차이 null + ACTUAL_RECEIPT_UNSET'
);


\echo '== S17 실제 입고일 입력 — PLAN_CONFIRM이 아니면 거절된다 =='
set role authenticated;
select sched_test.as_user(:'lead1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.record_actual_receipt_date(%L, '2026-11-19', null)$f$, :'s16_sched'),
  '실제 입고일 입력 권한', 'S17 PLAN_APPROVE만 가진 SCM팀장은 실제 입고일을 입력할 수 없다'
);
reset role;
set role authenticated;
select sched_test.as_user(:'marketing1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.record_actual_receipt_date(%L, '2026-11-19', null)$f$, :'s16_sched'),
  '실제 입고일 입력 권한', 'S17 권한 없는 사용자는 실제 입고일을 입력할 수 없다'
);
reset role;


\echo '== S18 계산되지 않은(EXCLUDED) 일정에는 실제 입고일을 입력할 수 없다 =='
select schedule_id as s18_sched from analytics.v_procurement_schedule where plan_id = :'plan_nov' and item_id = 'T10BITM2' \gset
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select sched_test.expect_error(
  format($f$select core.record_actual_receipt_date(%L, '2026-11-19', null)$f$, :'s18_sched'),
  '일정이 계산되지 않은 항목', 'S18 EXCLUDED(SUPPLIER_UNSET) 행에는 실제 입고일을 입력할 수 없다'
);
reset role;


\echo '== S19 법인 · 품목 · 월별 집계가 같은 원천 행을 쓴다(합이 서로 같다) =='
select coalesce(sum(n_total), 0) as s19_entity_sum from analytics.v_receipt_gap_entity \gset
select coalesce(sum(n_total), 0) as s19_item_sum from analytics.v_receipt_gap_item \gset
select coalesce(sum(n_total), 0) as s19_month_sum from analytics.v_receipt_gap_month \gset
select coalesce(sum(n_actual_recorded), 0) as s19_entity_recorded from analytics.v_receipt_gap_entity \gset
select coalesce(sum(n_actual_recorded), 0) as s19_item_recorded from analytics.v_receipt_gap_item \gset
select coalesce(sum(n_actual_recorded), 0) as s19_month_recorded from analytics.v_receipt_gap_month \gset
select (select count(*) from core.procurement_schedule where calculation_status = 'SCHEDULED') as s19_scheduled_total \gset
select sched_test.check(:s19_entity_sum = :s19_scheduled_total, 'S19 법인별 n_total 합 = SCHEDULED 전체 건수');
select sched_test.check(:s19_item_sum = :s19_scheduled_total, 'S19 품목별 n_total 합 = SCHEDULED 전체 건수');
select sched_test.check(:s19_month_sum = :s19_scheduled_total, 'S19 월별 n_total 합 = SCHEDULED 전체 건수');
select sched_test.check(:s19_entity_recorded = :s19_item_recorded and :s19_item_recorded = :s19_month_recorded,
  'S19 실제 입고일이 기록된 건수 합도 세 뷰가 서로 같다');
select sched_test.check(:s19_entity_recorded = 2, 'S19 지금까지 실제 입고일을 입력한 행은 2건(S14 · S14b)');


\echo '== S20 평균 · 합계는 실제 입고일이 있는 행만 쓴다 =='
select avg_gap_days as s20_t10b_avg, sum_gap_days as s20_t10b_sum, n_total as s20_t10b_total, n_actual_recorded as s20_t10b_recorded, n_actual_unset as s20_t10b_unset
  from analytics.v_receipt_gap_entity where entity_id = 'T10B' \gset
-- T10B: 11월 T10BITM1(차이 2) + 12월 T10BITM8(미기록) = 평균 · 합계 모두 2(기록된 한 건만)
select sched_test.check(:s20_t10b_total = 2, 'S20 T10B 법인 전체 SCHEDULED 2건(11월 · 12월)');
select sched_test.check(:s20_t10b_recorded = 1 and :s20_t10b_unset = 1, 'S20 그중 기록 1건 · 미기록 1건');
select sched_test.check(:s20_t10b_avg = 2 and :s20_t10b_sum = 2, 'S20 평균 · 합계는 기록된 1건만 반영한다(미기록 행은 섞지 않는다)');


\echo '== S21 월별 집계는 확정 계획 입고일 기준이다 =='
select sched_test.check(
  (select n_total from analytics.v_receipt_gap_month where target_month = '2026-11-01') = 2,
  'S21 11월(확정 계획 입고일 기준)에 T10BITM1 · T10BITM9 두 건이 잡힌다'
);
select sched_test.check(
  (select n_total from analytics.v_receipt_gap_month where target_month = '2026-12-01') = 1,
  'S21 12월에 T10BITM8 한 건'
);


\echo '== S22 RLS — 권한 없는 사용자는 core.procurement_schedule과 뷰 모두 빈 결과다 =='
set role authenticated;
select sched_test.as_user(:'marketing1') \g /dev/null
select count(*) as s22_table from core.procurement_schedule \gset
select count(*) as s22_view from analytics.v_procurement_schedule \gset
reset role;
select sched_test.check(:s22_table = 0, 'S22 MARKETING은 core.procurement_schedule을 직접 조회해도 0건(RLS)');
select sched_test.check(:s22_view = 0, 'S22 MARKETING은 analytics.v_procurement_schedule도 0건(security_invoker)');

set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select count(*) as s22_planner_view from analytics.v_procurement_schedule \gset
reset role;
select sched_test.check(:s22_planner_view = 10, 'S22 PLAN_CONFIRM은 전체 10건(11월 8 · 8월 1 · 12월 1)을 본다');


\echo '== S23 하드 쓰기 금지 — authenticated는 core.procurement_schedule을 함수 없이 직접 쓸 수 없다 =='
set role authenticated;
select sched_test.as_user(:'planner1') \g /dev/null
select sched_test.expect_error(
  $f$update core.procurement_schedule set reason_code = 'SUPPLIER_UNSET' where plan_id = '00000000-0000-4000-8000-000000009999'::uuid$f$,
  'permission denied for table procurement_schedule', 'S23 PLAN_CONFIRM이어도 직접 UPDATE는 GRANT가 없어 거절된다'
);
reset role;
