-- 영업 주문 · 배정 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists order_test;
grant usage on schema order_test to anon, authenticated;

create or replace function order_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function order_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function order_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

create or replace function order_test.available(p_item text) returns numeric language sql as $$
  select sb.normal_qty - coalesce((
    select sum(a.qty) from core.stock_allocation a where a.item_id = sb.item_id and a.status <> 'RELEASED'
  ), 0)
  from core.stock_balance sb where sb.item_id = p_item
$$;

-- Task 6: 신규 입고 배치를 커밋된 core.apply_stock_receipts_from_batch 경로로 흉내 낸다
-- (STEP4/Task4의 정식 경로와 같은 raw.goods_receipt 열을 그대로 쓴다).
create or replace function order_test.commit_goods_receipt(
  p_item_id text, p_qty numeric, p_source_record_id text default null, p_receipt_status text default 'COMPLETED'
) returns uuid language plpgsql as $$
declare
  v_batch_id uuid := gen_random_uuid();
  v_source_record_id text := coalesce(p_source_record_id, 'GR-' || replace(gen_random_uuid()::text, '-', ''));
begin
  insert into core.upload_batch (batch_id, file_name, import_type, import_mode, status)
  values (v_batch_id, 'order_test-fixture.csv', 'goods_receipt', 'append', 'VALIDATED');

  insert into raw.goods_receipt ("품목코드", "입고수량", "입고일", source_record_id, batch_id, receipt_status, source_type, loaded_at)
  values (p_item_id, p_qty::text, now()::text, v_source_record_id, v_batch_id, p_receipt_status, 'FILE_UPLOAD', now());

  perform core.apply_stock_receipts_from_batch(v_batch_id);
  return v_batch_id;
end $$;

grant execute on all functions in schema order_test to anon, authenticated;

