-- Task 6: 품목별 배정 방식(core.item_policy.allocation_mode). ITEMT25는 MANUAL, 나머지는
-- 정책이 없을 때 기본값 AUTO를 확인하는 대조군으로 일부만 명시적으로 넣는다.
insert into core.item_policy (item_id, allocation_mode) values
  ('ITEMT24', 'AUTO'),
  ('ITEMT25', 'MANUAL'),
  ('ITEMT26', 'AUTO'),
  ('ITEMCJ01', 'AUTO')
on conflict (item_id) do update set allocation_mode = excluded.allocation_mode;

