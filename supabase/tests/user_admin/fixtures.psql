-- 관리자 계정 관리 검증 fixture — 로컬 임시 DB(scm_test_*) 전용. 운영 마이그레이션에 넣지 않는다.
-- 구조는 supabase/tests/master_edit/fixtures.psql과 같다.
\set ON_ERROR_STOP 1
\ir guard.psql

create schema if not exists user_admin_test;
grant usage on schema user_admin_test to anon, authenticated;

create or replace function user_admin_test.as_user(p_user uuid) returns text language sql as $$
  select set_config('request.jwt.claim.sub', p_user::text, false)
$$;

create or replace function user_admin_test.check(p_ok boolean, p_label text) returns text language plpgsql as $$
begin
  if p_ok is distinct from true then
    raise exception 'FAIL: %', p_label;
  end if;
  return 'PASS: ' || p_label;
end $$;

create or replace function user_admin_test.expect_error(p_sql text, p_pattern text, p_label text) returns text language plpgsql as $$
declare
  v_state text;
  v_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics v_state = returned_sqlstate, v_message = message_text;
    if v_message !~ p_pattern then
      raise exception 'FAIL: % — 다른 오류: % (%)', p_label, v_message, v_state;
    end if;
    return 'PASS: ' || p_label || ' → ' || v_state || ' ' || v_message;
  end;
  raise exception 'FAIL: % — 오류가 나지 않았습니다: %', p_label, p_sql;
end $$;

grant execute on all functions in schema user_admin_test to anon, authenticated;

-- auth.users에 넣으면 core.handle_new_auth_user()(STEP 2) 트리거가 role=USER · active=true인
-- 기본 core.app_user 행을 자동으로 만든다 — 실제 Admin API 흐름과 같다. 아래 upsert는 그 기본값을
-- 검증 시나리오가 원하는 값(ADMIN 포함)으로 덮어쓴다.
insert into auth.users (id, email) values
  ('00000000-0000-4000-8000-000000000501', 'ua-admin1@example.test'),
  ('00000000-0000-4000-8000-000000000502', 'ua-admin2@example.test'),
  ('00000000-0000-4000-8000-000000000503', 'ua-user1@example.test'),
  ('00000000-0000-4000-8000-000000000504', 'ua-clean@example.test'),
  ('00000000-0000-4000-8000-000000000505', 'ua-history@example.test'),
  ('00000000-0000-4000-8000-000000000506', 'ua-newprofile@example.test'),
  ('00000000-0000-4000-8000-000000000507', 'ua-orphan@example.test')
on conflict (id) do nothing;

-- fix round 1 · C1 — 이메일/비밀번호로 만든 계정은 GoTrue가 auth.identities 행을 반드시 하나
-- 만든다. 이 fixture가 그 행을 실제와 같은 모양으로 넣지 않으면, "auth 스키마 자신의 FK까지
-- 참조로 잡던 버그"를 로컬에서 재현·회귀 검증할 수 없다.
insert into auth.identities (user_id, provider, provider_id, identity_data) values
  ('00000000-0000-4000-8000-000000000501', 'email', 'ua-admin1@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000502', 'email', 'ua-admin2@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000503', 'email', 'ua-user1@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000504', 'email', 'ua-clean@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000505', 'email', 'ua-history@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000506', 'email', 'ua-newprofile@example.test', '{}'::jsonb),
  ('00000000-0000-4000-8000-000000000507', 'email', 'ua-orphan@example.test', '{}'::jsonb)
on conflict do nothing;

insert into core.app_user (user_id, email, name, department, job_role, role, active) values
  ('00000000-0000-4000-8000-000000000501', 'ua-admin1@example.test', '관리자1', null, null, 'ADMIN', true),
  ('00000000-0000-4000-8000-000000000502', 'ua-admin2@example.test', '관리자2', null, null, 'ADMIN', true),
  ('00000000-0000-4000-8000-000000000503', 'ua-user1@example.test', '일반사용자1', 'SCM', null, 'USER', true),
  ('00000000-0000-4000-8000-000000000504', 'ua-clean@example.test', '이력없음', 'SALES', 'SALES_REP', 'USER', true),
  ('00000000-0000-4000-8000-000000000505', 'ua-history@example.test', '이력있음', 'SCM', 'SCM_PLANNER', 'USER', true)
on conflict (user_id) do update
  set role = excluded.role, active = true, name = excluded.name, department = excluded.department, job_role = excluded.job_role;

-- S3(신규 프로필 확정, 실제 운영 경로) 전용 — 트리거가 방금 만든 기본 행(role=USER ·
-- active=true · job_role=null)을 그대로 둔다. admin_upsert_app_user_profile(..., p_created =>
-- true)이 이 행 "위에" upsert된다 — 이것이 운영에서 실제로 타는 유일한 분기다(fix round 1 · I3).

-- S3(방어적 분기) 전용 — trigger 행이 없는 상태(예: 어떤 이유로 트리거가 못 만든 경우)를
-- fixture 준비 목적으로만(슈퍼유저로, 함수를 거치지 않고) 만든다. p_created를 안 넘겨도
-- v_before is null이면 여전히 USER_CREATED로 남아야 한다.
delete from core.app_user where user_id = '00000000-0000-4000-8000-000000000507';

-- S11(완전 삭제 — 업무 이력) 전용 — history 계정이 감사 로그의 actor로 등장한 적이 있게 만든다.
-- core.audit_log.actor는 on delete set null이라 DB가 스스로 삭제를 막지 않는 경우의 대표 예시다.
insert into core.audit_log (actor, action, target_type, target_id, before, after) values
  ('00000000-0000-4000-8000-000000000505', 'ITEM_POLICY_UPDATED', 'item_policy', 'ITEM-UA-TEST', '{}'::jsonb, '{}'::jsonb);

select 'fixtures ok';
